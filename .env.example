# Neon PostgreSQL (free tier có thể "ngủ" — lần kết nối đầu có thể mất ~15s)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Các frontend được phép gọi API trực tiếp, phân tách bằng dấu phẩy.
CORS_ORIGINS="https://www.hihienglish.com,https://hihienglish.com,https://hihienglishh.netlify.app"

# Frontend Vite trên Netlify — URL public của backend Railway, bao gồm /api
# Cấu hình biến này trong Netlify trước khi build/deploy frontend.
# VITE_API_BASE_URL="https://your-backend.up.railway.app/api"

# Tự động tạo/cập nhật bảng & cột khi khởi động server (mặc định: bật)
AUTO_SYNC_DB=true

# SMTP (tùy chọn — nếu không cấu hình, mã OTP sẽ in ra console)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password-no-spaces"
SMTP_FROM="Shadowing ENGLISH <noreply@shadowing.com>"

# OpenAI — dùng cho Shadowing STT (Whisper), Chat AI & luyện nói
OPENAI_API_KEY="sk-your-openai-api-key"

# Cloudinary — lưu ảnh đại diện người dùng (khuyến nghị dùng CLOUDINARY_URL)
# Chỉ bật dòng này sau khi đã thay toàn bộ giá trị mẫu bằng thông tin thật.
# CLOUDINARY_URL="cloudinary://123456789012345:replace-with-real-secret@your-real-cloud-name"
# Hoặc cấu hình riêng từng giá trị:
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# Model nhận dạng nhanh cho luyện nói
# SPEAKING_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# iFLYTEK Pronunciation Assessment (ISE) for pronunciation and fluency scores
# Enable ISE in the iFLYTEK console before adding these credentials.
# IFLYTEK_PRONUNCIATION_ENABLED=true
# IFLYTEK_APP_ID="your-iflytek-app-id"
# IFLYTEK_API_KEY="your-iflytek-api-key"
# IFLYTEK_API_SECRET="your-iflytek-api-secret"
# IFLYTEK_ISE_URL="wss://ise-api-sg.xf-yun.com/v2/ise"
# IFLYTEK_ISE_TIMEOUT_MS=25000
# IFLYTEK_ISE_FRAME_BYTES=1280
# IFLYTEK_ISE_FRAME_INTERVAL_MS=40

# ElevenLabs — TTS / clone giọng (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY="sk_your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="your-elevenlabs-voice-id"
# ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"

# Dịch video — đường dẫn yt-dlp (khi video không có caption, dùng Whisper)
# YT_DLP_PATH="D:/Code/ShowdingEng/backend/tools/yt-dlp.exe"
# YT_DLP_SKIP_INSTALL=true
# YT_DLP_INSTALL_REQUIRED=true
# YT_DLP_RELEASE_BASE_URL="https://github.com/yt-dlp/yt-dlp/releases/latest/download"
# FFMPEG_PATH="C:/path/to/ffmpeg.exe"
# VIDEO_TRANSLATE_MAX_SECONDS_FREE=600
# VIDEO_TRANSLATE_MAX_SECONDS_PREMIUM=1200
# Số câu mỗi request dịch (6-40) và số request chạy song song (1-6)
# VIDEO_TRANSLATE_BATCH_SIZE=24
# VIDEO_TRANSLATE_CONCURRENCY=3
# Production (IP datacenter thường bị YouTube bot-check): bắt buộc cookies
# 1) Đăng nhập YouTube trên trình duyệt → export cookies Netscape (cookies.txt)
# 2a) Mount file trên server:
# YT_DLP_COOKIES_PATH="/data/youtube-cookies.txt"
# 2b) Hoặc dán nội dung file đã base64 (phù hợp Railway/env secret):
# YT_DLP_COOKIES_BASE64="IyBOZXRzY2FwZSBIVFRQIENvb2tpZSBGaWxl..."
# YT_DLP_PROXY="http://user:pass@host:port"
# YT_DLP_FORCE_IPV4=true
# YT_DLP_EXTRACTOR_ARGS="youtube:player_client=android,tv,web"

# Google OAuth — đăng nhập / đăng ký bằng Google
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# SePay / VietQR — nhận thanh toán chuyển khoản
# QR mẫu: https://vietqr.app/img?bank=BIDV&acc=8858802106&template=compact&showinfo=true&holder=LE%20CHAU%20KIET
SEPAY_BANK="BIDV"
SEPAY_ACCOUNT_NUMBER="8858802106"
SEPAY_ACCOUNT_HOLDER="LE CHAU KIET"
SEPAY_PAYMENT_PREFIX="SHD"

# Chọn một phương thức xác thực webhook:
# 1) HMAC-SHA256 (khuyến nghị)
SEPAY_WEBHOOK_SECRET="replace-with-a-long-random-secret"
# 2) API Key (chỉ dùng nếu không cấu hình SEPAY_WEBHOOK_SECRET)
# SEPAY_WEBHOOK_API_KEY="replace-with-a-long-random-api-key"


























































































































































































































































































































































































































































































































































































































































































































































































































































































































































